{
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "(www\\.)?montbrison-forezbasketfeminin\\.com" }
      ],
      "destination": "/lf2-intro.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/rejoindre.html",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
